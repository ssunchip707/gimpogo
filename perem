<!-- ===================== Q7 과학적 근거 ===================== -->
<section class="layer">
  <div class="layer-head">
    <span class="layer-num">07 / 증거</span>
    <h2>무엇이 이 사건을 실증하는가</h2>
  </div>
  <div class="layer-body">
    <p>P-T 대멸종은 단일 증거가 아니라, 서로 독립적인 여러 지질학적·지구화학적 기록이 같은 시점을 가리키면서 성립하는 결론이다.</p>
    <div class="evidence-grid reveal">
      <div class="evid"><span class="idx">FOSSIL RECORD</span><h4>화석 다양성의 급격한 단절</h4><p>전 세계 여러 지층에서 경계면 상하로 화석 종의 수가 급격히 줄어드는 동일한 패턴이 반복적으로 관찰된다.</p></div>
      <div class="evid"><span class="idx">STRATA · GSSP</span><h4>메이샨 지층(국제표준층서구역)</h4><p>중국 저장성 메이샨의 연속 지층은 P-T 경계의 국제 표준 단면으로, 생물상 전환이 뚜렷한 층서로 기록되어 있다.</p></div>
      <div class="evid"><span class="idx">δ¹³C</span><h4>탄소동위원소 이상</h4><p>경계층에서 급격한 음(-)의 탄소동위원소 편이가 확인된다. 가벼운 탄소의 대규모 유입 — 화산 및 유기물 기원 — 을 뒷받침하는 지구화학적 지표다.</p></div>
      <div class="evid"><span class="idx">Hg ANOMALY</span><h4>수은 이상치</h4><p>화산활동의 지표인 수은 농축이 전 세계 다수의 P-T 경계 지층에서 발견되며, 시베리아 트랩의 활동 시기와 일치한다.</p></div>
      <div class="evid"><span class="idx">U-Pb DATING</span><h4>방사성동위원소 연대측정</h4><p>시베리아 트랩 용암층의 정밀 연대측정 결과가 멸종의 절정 시점과 통계적으로 구분되지 않을 만큼 근접한다.</p></div>
      <div class="evid"><span class="idx">S / B ISOTOPES</span><h4>황·붕소 동위원소</h4><p>해양 무산소·황화 상태(황동위원소)와 해양 산성화(붕소동위원소)를 정량적으로 복원하는 데 사용된다.</p></div>
      <div class="evid"><span class="idx">COAL GAP</span><h4>석탄 공백</h4><p>트라이아스기 초기 지층에서는 전 세계적으로 석탄층이 거의 발견되지 않는다 — 육상 식생 붕괴를 뒷받침하는 정황 증거다.</p></div>
      <div class="evid"><span class="idx">FUNGAL SPIKE</span><h4>균류 포자 급증층</h4><p>죽은 식물체를 분해하는 균류의 화석 포자가 경계층 부근에서 급증한 흔적 — 대규모 고사(枯死)를 시사하는 논쟁적 지표로 제시된다.</p></div>
    </div>
  </div>
</section>

<footer>
  <div class="foot-title">The Great Dying — 페름기 대멸종</div>
  <p class="note">이 자료는 페름기-트라이아스기 경계(약 2억 5,200만 년 전)의 대멸종에 관한 고생물학·지질학 연구를 정리한 발표용 자료이다. 개별 수치와 가설은 여전히 연구가 진행 중이며 학계 내 이견이 존재할 수 있다.</p>
</footer>

<script>
  // ---- reveal on scroll (replays every time it re-enters view) ----
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('in'); }
      else{ e.target.classList.remove('in'); }
    });
  },{ threshold:0, rootMargin:'0px 0px -12% 0px' });
  revealEls.forEach(el=>io.observe(el));

  // ---- timeline fill trigger (replays) ----
  const tl = document.getElementById('tl1');
  const tlio = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ tl.classList.add('in'); }
      else{ tl.classList.remove('in'); }
    });
  },{ threshold:0, rootMargin:'0px 0px -12% 0px' });
  tlio.observe(tl);

  // ---- count-up numbers (replays every time it re-enters view) ----
  const counters = document.querySelectorAll('[data-count]');
  const counterState = new Map();
  counters.forEach(el=>{
    const target = parseFloat(el.getAttribute('data-count'));
    const suffix = el.getAttribute('data-suffix') || '';
    counterState.set(el, { target, suffix, raf:null });
  });
  const cio = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(!e.isIntersecting) return;
      const el = e.target;
      const state = counterState.get(el);
      if(state.raf) cancelAnimationFrame(state.raf);
      if(isNaN(state.target) || state.target === 0){
        el.textContent = state.suffix || el.textContent;
        return;
      }
      el.textContent = '0' + state.suffix;
      let start = null;
      const dur = 1400;
      function step(ts){
        if(!start) start = ts;
        const p = Math.min((ts-start)/dur, 1);
        const val = Math.floor(p * state.target);
        el.textContent = val + state.suffix;
        if(p < 1) state.raf = requestAnimationFrame(step);
        else el.textContent = state.target + state.suffix;
      }
      state.raf = requestAnimationFrame(step);
    });
  },{ threshold:0, rootMargin:'0px 0px -12% 0px' });
  counters.forEach(el=>cio.observe(el));

  // ---- hero die-off canvas ----
  const canvas = document.getElementById('dieoff');
  const ctx = canvas.getContext('2d');
  let W, H;
  function resize(){
    W = canvas.width = canvas.offsetWidth * devicePixelRatio;
    H = canvas.height = canvas.offsetHeight * devicePixelRatio;
  }
  resize();
  window.addEventListener('resize', resize);

  const N = 260;
  const particles = [];
  for(let i=0;i<N;i++){
    particles.push({
      x: Math.random(),
      y: Math.random(),
      r: (Math.random()*1.6+0.6) * devicePixelRatio,
      alive: true,
      deathAt: 1400 + Math.random()*3600, // ms after start, staggered die-off
      born: performance.now()
    });
  }
  const survivorCount = Math.round(N * 0.19); // ~81% die off
  particles.forEach((p,i)=>{ if(i < survivorCount) p.deathAt = Infinity; });
  // shuffle so survivors aren't spatially clustered
  for(let i=particles.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    const tmp = particles[i].deathAt; particles[i].deathAt = particles[j].deathAt; particles[j].deathAt = tmp;
  }

  const t0 = performance.now();
  function frame(now){
    const t = now - t0;
    ctx.clearRect(0,0,W,H);
    particles.forEach(p=>{
      const isDead = t > p.deathAt;
      const fadeProgress = isDead ? Math.min((t - p.deathAt)/800, 1) : 0;
      const alpha = isDead ? Math.max(1 - fadeProgress, 0.05) : 0.9;
      const flicker = isDead && fadeProgress < 1 ? Math.random()*0.3 : 0;
      ctx.beginPath();
      ctx.arc(p.x*W, p.y*H, p.r * (isDead ? (1-fadeProgress*0.5) : 1), 0, Math.PI*2);
      ctx.fillStyle = `rgba(231,226,212,${Math.max(alpha-flicker,0.04)})`;
      ctx.fill();
    });
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
</script>

